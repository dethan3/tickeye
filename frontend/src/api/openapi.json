{
  "openapi": "3.1.0",
  "info": {
    "title": "TickEye",
    "version": "2.0.0.dev0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Get Health",
        "description": "Verify that the API process can execute a database query.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComponentHealth": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ComponentHealth",
        "description": "Status of one dependency checked by the API."
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "database": {
            "$ref": "#/components/schemas/ComponentHealth"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "version",
          "database"
        ],
        "title": "HealthResponse",
        "description": "Public readiness response consumed by the local frontend."
      }
    }
  }
}
